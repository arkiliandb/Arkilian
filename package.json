{
  "name": "arkilian",
  "version": "1.0.0",
  "description": "Arkilian - SQLite wrapper with automated cloud backup for Node.js/Bun",
  "main": "index.js",
  "scripts": {
    "install": "node-gyp configure && node-gyp build",
    "build": "node-gyp configure && node-gyp build",
    "clean": "node-gyp clean",
    "test": "node test.js"
  },
  "keywords": [
    "sqlite",
    "database",
    "backup",
    "s3",
    "node",
    "bun",
    "ffi"
  ],
  "author": "CodeDynasty-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeDynasty-dev/birth-of-Arkilian.git"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0"
  },
  "gypfile": true,
  "files": [
    "index.js",
    "test.js",
    "binding.gyp",
    "package.json",
    "LICENSE",
    "README.md",
    "src/class.h",
    "src/arkilian.cc",
    "src/deps/sqlite/sqlite3.h",
    "src/deps/sqlite/sqlite3ext.h",
    "build/Release/arkilian.node"
  ],
  "binary": {
    "module_name": "arkilian",
    "module_path": "./build/Release",
    "host": "https://github.com/CodeDynasty-dev/birth-of-Arkilian/releases/download/{version}"
  }
}