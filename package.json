{
  "name": "arkilian",
  "version": "1.5.0",
  "description": "Arkilian - SQLite wrapper with automated cloud backup for Node.js/Bun",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp configure && node-gyp build",
    "build:cmake": "cmake-js compile -T arkilian_napi",
    "clean": "node-gyp clean",
    "pretest": "node-gyp configure && node-gyp build",
    "test": "node test.js",
    "prebuildify": "prebuildify --napi --strip",
    "release:packages": "bash scripts/build-release-packages.sh"
  },
  "keywords": [
    "sqlite",
    "database",
    "backup",
    "s3",
    "node",
    "bun",
    "ffi"
  ],
  "author": "CodeDynasty-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkiliandb/Arkilian.git"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "cmake-js": "^8.0.0",
    "node-gyp": "^10.0.0",
    "prebuildify": "^6.0.0"
  },
  "gypfile": false,
  "files": [
    "index.js",
    "binding.gyp",
    "LICENSE",
    "README.md",
    "prebuilds/",
    "src/class.c",
    "src/class.h",
    "src/arkilian.cc",
    "src/hydration.c",
    "src/hydration.h",
    "src/sha256.c",
    "src/sha256.h",
    "src/deps/sqlite/sqlite3.c",
    "src/deps/sqlite/sqlite3.h",
    "src/deps/sqlite/sqlite3ext.h"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "private": false,
  "homepage": "https://arkilian.com"
}
